TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
AUTH_SECRET=
LP_ACCESS_PASSWORD=

# Optional server-only AI settings
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Gemini is selected automatically when its key is present.
# Optional explicit selection: AI_PROVIDER=gemini or openai
GEMINI_API_KEY=
# Optional backup; another key in the same Google project shares its quota.
GEMINI_API_KEY_BACKUP=
GEMINI_MODEL=gemini-3.5-flash-lite

# Enable only after the guarded semantic upload reports cloud-ready.
LP_SEMANTIC_ENABLED=false

# Server-only PubMed access. Automatically used when configured unless disabled.
NCBI_API_KEY=
# Optional developer contact supplied to NCBI; not a patient email.
NCBI_EMAIL=
# Set false to keep answer retrieval library-only.
LP_PUBMED_ENABLED=true

# Free MedlinePlus keyword summaries; no key needed. Set false to disable this provider.
LP_MEDLINEPLUS_ENABLED=true
